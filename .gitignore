# Python
__pycache__/
*.pyc
.venv/
.env

# Data products: raw inputs are retained locally, and processed products are
# always recreated by scripts in src/. Neither belongs in the code repository.
/data/raw/
/data/processed/
/data/cache/
/data/analysis/
/data/external/

# LaTeX build files
*.aux
*.log
*.out
*.toc
*.lof
*.lot
*.fls
*.fdb_latexmk
*.synctex.gz

# Generated reports and diagnostics
/reports/main/*
/reports/working/
/reports/thesis/*
/reports/reproduced/
/archive/

# Versioned thesis deliverables and retained results. Everything in main is a
# selected thesis result; intermediate and diagnostic outputs stay in working.
!/reports/main/figures/
!/reports/main/figures/*.png
!/reports/main/tables/
!/reports/main/tables/*.csv
!/reports/main/tables/*.md
!/reports/thesis/*.tex
!/reports/thesis/*.pdf
!/reports/thesis/*.png
!/reports/thesis/*.md
!/reports/thesis/generated/
!/reports/thesis/generated/*.tex
/reports/thesis/*.bbl
/reports/thesis/*.blg

# Local scratch files
.Rhistory
/todo.md
/PROJECT_MAP.md
/PROJECT_STRUCTURE.md
/scripts/
/AGENTS.md

# OS/editor
.DS_Store
.vscode/
